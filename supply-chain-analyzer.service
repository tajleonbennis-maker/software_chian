[Unit]
Description=Supply Chain Security Analyzer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/supply-chain-analyzer
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/supply-chain-analyzer/.venv/bin/gunicorn --workers 1 --threads 8 --timeout 180 --bind 0.0.0.0:5566 app:app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
