# FOFA API 凭据
FOFA_EMAIL=your_fofa_email@example.com
FOFA_KEY=your_fofa_api_key
FOFA_SIZE=100

# DeepSeek AI API 配置
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
RESEARCH_AI_MODEL=deepseek-v4-pro
AI_ANALYSIS_ENABLED=true
AI_TIMEOUT=60

# 应用配置
SCAN_TIMEOUT=10
MAX_WORKERS=5
HOST=127.0.0.1
PORT=5566
DEBUG=false
DATABASE_PATH=data/scans.db

# 自动研究大脑（被动发现，不执行漏洞利用）
RESEARCH_BRAIN_ENABLED=true
RESEARCH_INTERVAL_SECONDS=3600
RESEARCH_DISCOVERY_SIZE=100
RESEARCH_ANALYSIS_BATCH=10

# ============================================================
# 分布式执行引擎配置（大脑端 121.41.98.7 使用）
# ============================================================
# 执行引擎上报/下发任务的共享 token（大脑与各执行引擎必须一致）
LAB_REPORT_TOKEN=change_me_shared_token

# 执行引擎节点列表（JSON 数组）：
#   每项：node_id, name, url, token, capabilities, enabled
#   url 是执行引擎 worker 的地址；token 与 LAB_REPORT_TOKEN 保持一致
EXECUTOR_NODES=[{"node_id":"node-a","name":"引擎A","url":"http://165.154.226.119:5566","token":"change_me_shared_token","capabilities":["fofa","vuln","api","tech"],"enabled":true},{"node_id":"node-b","name":"引擎B","url":"http://38.55.107.226:5566","token":"change_me_shared_token","capabilities":["fofa","vuln","api","tech"],"enabled":true}]

# 向执行引擎下发任务的超时（秒）
NODE_HTTP_TIMEOUT=30

# ============================================================
# 执行引擎 Worker 配置（在 165.154.226.119 / 38.55.107.226 上使用）
# ============================================================
# 大脑地址（worker 向大脑上报/拉取任务的入口）
BRAIN_URL=http://121.41.98.7:5566
# 本节点唯一 ID 与名称
NODE_ID=node-a
NODE_NAME=引擎A
# 与大脑 LAB_REPORT_TOKEN 一致
NODE_TOKEN=change_me_shared_token
# 本节点能力
NODE_CAPABILITIES=fofa,vuln,api,tech
# 心跳间隔（秒）
HEARTBEAT_INTERVAL=60

