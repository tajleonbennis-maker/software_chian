# FOFA API 凭据
FOFA_EMAIL=your_fofa_email@example.com
FOFA_KEY=your_fofa_api_key
FOFA_SIZE=100

# DeepSeek AI API 配置
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
RESEARCH_AI_MODEL=deepseek-v4-pro
AI_ANALYSIS_ENABLED=true
AI_TIMEOUT=60

# 应用配置
SCAN_TIMEOUT=10
MAX_WORKERS=5
HOST=127.0.0.1
PORT=5566
DEBUG=false
DATABASE_PATH=data/scans.db

# 自动研究大脑（被动发现，不执行漏洞利用）
RESEARCH_BRAIN_ENABLED=true
RESEARCH_INTERVAL_SECONDS=3600
RESEARCH_DISCOVERY_SIZE=100
RESEARCH_ANALYSIS_BATCH=10
